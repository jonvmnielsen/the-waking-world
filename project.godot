; Engine configuration file.
; Oprettet som placeholder - erstattes når Godot 4 åbner projektet.
; https://docs.godotengine.org/en/stable/tutorials/export/index.html

[configuration]

entry_symbol = "gdextension_init"
compatibility_minimum = "4.1"

[application]

config/name = "The Waking World"
config/description = "Isometrisk RTS/RPG inspireret af Warcraft 3"
config/version = "0.0.1"
run/main_scene = "res://scenes/world/maps/ashfield.tscn"
config/features = PackedStringArray("4.3", "Forward Plus")

[display]

window/size/viewport_width = 1920
window/size/viewport_height = 1080
window/stretch/mode = "canvas_items"
window/stretch/aspect = "expand"

[rendering]

renderer/rendering_method = "forward_plus"
